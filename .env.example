# Database configuration
DATABASE_URL=postgresql://user:password@db:5432/mydb?schema=public
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb

# Customer data encryption: generate with openssl rand -hex 32; preserve with backups.
CUSTOMER_DATA_ENCRYPTION_KEY=

# Authentication
JWT_SECRET=replace-with-a-long-random-local-secret

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_DB=0

# Application and email configuration
API_URL=https://shop.banecon.site/api
CUSTOMER_APP_URL=https://shop.banecon.site
CORS_ORIGINS=https://shop.banecon.site
SWAGGER_ENABLED=false
PORT=3000
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Melodies Store <no-reply@localhost>

# Currently documented but not read by application code
BCRYPT_SALT_ROUNDS=10

# MoMo wallet: sandbox first. Use merchant credentials from MoMo.
# API_URL must be publicly reachable for /payment/momo/ipn and /payment/momo/return.
MOMO_ENVIRONMENT=sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# Stripe Checkout: test keys only; webhook secret from Stripe CLI or Dashboard.
STRIPE_ENVIRONMENT=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
