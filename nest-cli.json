{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "deleteOutDir": true,
        "assets": [
            { "include": "**/*.hbs", "watch": true, "outDir": "dist/src" },
            {
                "include": "database/**/*.json",
                "outDir": "dist/src",
                "watchAssets": true
            }
        ],
        "watchAssets": true
    }
}
